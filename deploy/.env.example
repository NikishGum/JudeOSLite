# Local development only. Replace the password in your untracked deploy/.env.
POSTGRES_DB=judeoslite
POSTGRES_USER=judeoslite
POSTGRES_PASSWORD=local-development-only
APP_PORT=8080
DB_PORT=5432

# HTTP loopback only. On a VPS set your HTTPS origin and false.
APP_ORIGIN=http://localhost:8080
AUTH_INSECURE_LOCAL=true
