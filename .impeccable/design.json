      "html": "<button class=\"ds-primary\" type=\"button\">Сохранить</button>",
      "css": ".ds-primary{font-family:var(--font-sans);min-height:44px;padding:10px 16px;border:1px solid transparent;border-radius:5px;font-size:14px;font-weight:500;line-height:1.4;cursor:pointer;transition:background-color 150ms ease-out;background:var(--primary);color:var(--primary-foreground)}.ds-primary:hover:not(:disabled){background:var(--pride-brand-hover)}.ds-primary:focus-visible{outline:2px solid var(--ring);outline-offset:3px;}.ds-primary:disabled{opacity:.6;cursor:default}@media(max-width:767px){.ds-primary{font-size:16px}}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none;scroll-behavior:auto}}",
