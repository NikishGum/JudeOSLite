  "components": [
    {
      "name": "Основная кнопка",
      "kind": "button",
      "description": "Реальное главное действие; пример native-варианта в общей теме.",
      "html": "<button class=\"ds-primary\" type=\"button\">Сохранить</button>",
      "css": ".ds-primary{font-family:var(--font-sans, 'Rubik', sans-serif);min-height:44px;padding:10px 16px;border:1px solid transparent;border-radius:5px;font-size:14px;font-weight:500;line-height:1.4;cursor:pointer;background:var(--primary,#db0c0c);color:var(--primary-foreground,#fff)}.ds-primary:hover:not(:disabled){background:var(--pride-brand-hover,#323232)}.ds-primary:focus-visible{outline:2px solid var(--ring,#db0c0c);outline-offset:3px;}.ds-primary:disabled{opacity:.6;cursor:default}@media(max-width:767px){.ds-primary{font-size:16px}}",
      "refersTo": "button-primary"
    },
    {
      "name": "Вторичная кнопка",
      "kind": "button",
      "description": "Нейтральное действие, включая нижнюю отмену панели.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Отмена</button>",
      "css": ".ds-secondary{font-family:var(--font-sans, 'Rubik', sans-serif);min-height:44px;padding:10px 16px;border:1px solid transparent;border-radius:5px;font-size:14px;font-weight:500;line-height:1.4;cursor:pointer;background:var(--card,#fff);color:var(--foreground,#212529);border-color:var(--border,#dedede)}.ds-secondary:hover:not(:disabled){background:var(--muted,#f5f7fa)}.ds-secondary:focus-visible{outline:2px solid var(--ring,#db0c0c);outline-offset:3px;}.ds-secondary:disabled{opacity:.6;cursor:default}@media(max-width:767px){.ds-secondary{font-size:16px}}",
      "refersTo": "button-secondary"
    },
    {
      "name": "Кнопка имени",
      "kind": "button",
      "description": "Участник открывается по имени; статус имеет собственную доступную подпись.",
      "html": "<span class=\"ds-person\"><span class=\"ds-dot\" role=\"img\" aria-label=\"Действующий участник\" title=\"Действующий участник\"></span><button class=\"ds-name\" type=\"button\">Имя участника</button></span>",
      "css": ".ds-person{display:flex;align-items:center;gap:12px}.ds-dot{display:inline-block;width:8px;height:8px;flex:none;border-radius:50%;background:var(--success,#24664e)}.ds-name{font-family:var(--font-sans, 'Rubik', sans-serif);min-height:44px;padding:8px 0;border:0;background:transparent;color:var(--foreground,#212529);font-size:14px;font-weight:500;text-align:left;overflow-wrap:anywhere;cursor:pointer}.ds-name:hover:not(:disabled){color:var(--primary,#db0c0c);text-decoration:underline}.ds-name:focus-visible{outline:2px solid var(--ring,#db0c0c);outline-offset:3px;}.ds-name:disabled{opacity:.6;cursor:default}@media(max-width:767px){.ds-name{font-size:16px}}"
    },
    {
      "name": "Поле с подписью",
      "kind": "input",
      "description": "Native поле повторяет общие поверхность, границу и фокус.",
      "html": "<label class=\"ds-field\">ФИО участника<input class=\"ds-input\" type=\"text\" autocomplete=\"off\" placeholder=\"Имя участника\"></label>",
      "css": ".ds-field{font-family:var(--font-sans, 'Rubik', sans-serif);display:grid;gap:8px;color:var(--foreground,#212529);font-size:14px;font-weight:500}.ds-input{font-family:var(--font-sans, 'Rubik', sans-serif);min-width:0;min-height:44px;padding:12px;border:1px solid var(--input,#dedede);border-radius:10px;background:var(--card,#fff);color:var(--foreground,#212529);font-size:14px;line-height:1.4;caret-color:var(--primary,#db0c0c)}.ds-input:focus-visible{outline:2px solid var(--ring,#db0c0c);outline-offset:3px;}.ds-input:disabled{opacity:.65}@media(max-width:767px){.ds-field,.ds-input{font-size:16px}}",
      "refersTo": "field"
    },
    {
      "name": "Активная навигация",
      "kind": "nav",
      "description": "Доступное название раздела, SVG и явное выбранное состояние.",
      "html": "<nav aria-label=\"Разделы\"><a class=\"ds-nav\" href=\"#participants\" aria-current=\"page\"><svg aria-hidden=\"true\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75\"></path></svg><span>Участники</span></a></nav>",
      "css": ".ds-nav{font-family:var(--font-sans, 'Rubik', sans-serif);display:flex;align-items:center;gap:12px;min-height:44px;padding:12px;border-radius:8px;color:var(--sidebar-foreground,#444862);font-size:14px;text-decoration:none}.ds-nav:hover{background:var(--muted,#f5f7fa)}.ds-nav[aria-current]{background:var(--sidebar-accent,#fcecec);color:var(--sidebar-accent-foreground,#b50909);font-weight:500}.ds-nav:focus-visible{outline:2px solid var(--ring,#db0c0c);outline-offset:3px;}",
      "refersTo": "navigation-active"
    },
    {
      "name": "Рабочая панель",
      "kind": "card",
      "description": "Белая плоская поверхность с заголовком панели и адаптивным отступом.",
      "html": "<section class=\"ds-panel\"><h2>Участники</h2><p>Состав выбранного филиала</p></section>",
      "css": ".ds-panel{font-family:var(--font-sans, 'Rubik', sans-serif);min-width:0;background:var(--card,#fff);color:var(--foreground,#212529);border:0;border-radius:20px;padding:24px}.ds-panel h2{margin:0;font-size:17px;line-height:1.4;font-weight:600}.ds-panel p{margin:12px 0 0;color:var(--muted-foreground,#626b72);font-size:13px;line-height:1.6}@media(max-width:767px){.ds-panel{padding:20px 16px}}",
      "refersTo": "panel"
    },
    {
      "name": "Строка сотрудника",
      "kind": "custom",
      "description": "Не сжимающийся fallback-аватар и единые отступы16×12px.",
      "html": "<div class=\"ds-staff\"><span class=\"ds-avatar\"><span aria-hidden=\"true\">ИС</span><span class=\"ds-staff-dot\" role=\"img\" aria-label=\"Действующий аккаунт\" title=\"Действующий аккаунт\"></span></span><div class=\"ds-staff-copy\"><h3>Имя сотрудника</h3><p>Тренер</p><p class=\"ds-assignment\">Назначенный филиал</p></div></div>",
      "css": ".ds-staff{font-family:var(--font-sans, 'Rubik', sans-serif);display:flex;align-items:start;gap:16px;padding:16px 12px;color:var(--foreground,#212529)}.ds-staff:hover{background:var(--muted,#f5f7fa)}.ds-avatar{position:relative;display:grid;place-items:center;flex:none;width:44px;height:44px;border:1px solid var(--border,#dedede);border-radius:50%;background:var(--muted,#f5f7fa);color:var(--muted-foreground,#626b72);font-size:14px}.ds-staff-dot{position:absolute;bottom:1px;right:0;width:8px;height:8px;border-radius:50%;background:var(--success,#24664e);box-shadow:0 0 0 2px var(--card,#fff)}.ds-staff-copy{min-width:0;display:flex;flex-direction:column;gap:2px}.ds-staff-copy h3{margin:0;font-size:15px;line-height:22px;font-weight:500;overflow-wrap:anywhere}.ds-staff-copy p{margin:0;color:var(--muted-foreground,#626b72);font-size:12px;line-height:18px}.ds-staff-copy .ds-assignment{margin-top:4px;font-size:13px;line-height:20px}@media(max-width:767px){.ds-staff{gap:12px}.ds-staff-copy h3{font-size:16px}}"
    },
    {
      "name": "Объединённая дата",
      "kind": "custom",
      "description": "Настольная компактная группа; на телефоне области44px.",
      "html": "<div class=\"ds-date-group\"><button class=\"ds-date-step\" type=\"button\" aria-label=\"Предыдущий день\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m15 18-6-6 6-6\"></path></svg></button><button class=\"ds-date-value\" type=\"button\">18 октября 2026 г.</button><button class=\"ds-date-step\" type=\"button\" aria-label=\"Следующий день\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m9 18 6-6-6-6\"></path></svg></button></div>",
      "css": ".ds-date-group{display:inline-flex;align-items:center;gap:0;padding:2px;border:1px solid var(--border,#dedede);border-radius:10px;background:var(--card,#fff)}.ds-date-group button{font-family:var(--font-sans, 'Rubik', sans-serif);display:inline-flex;align-items:center;justify-content:center;min-height:32px;height:32px;border:0;border-radius:6px;background:transparent;color:var(--foreground,#212529);cursor:pointer}.ds-date-step{width:32px;min-width:32px;padding:0}.ds-date-value{padding:0 10px;font-size:13px}.ds-date-group button:hover:not(:disabled){background:var(--muted,#f5f7fa)}.ds-date-group button:focus-visible{outline:2px solid var(--ring,#db0c0c);outline-offset:3px;}.ds-date-group button:disabled{opacity:.6;cursor:default}@media(max-width:767px){.ds-date-group button{height:44px;min-height:44px}.ds-date-step{width:44px;min-width:44px}.ds-date-value{font-size:16px}}"
    },
    {
      "name": "Заголовок native sheet",
      "kind": "custom",
      "description": "Верхний видимый выход длинной панели; runtime связывает его с guarded cancel.",
      "html": "<section class=\"ds-sheet\" aria-label=\"Карточка участника\"><header class=\"ds-sheet-header\"><h4>Карточка участника</h4><button type=\"button\" class=\"ds-sheet-close\" aria-label=\"Закрыть панель «Карточка участника»\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 6 6 18M6 6l12 12\"></path></svg></button></header><p>Содержимое рабочей панели</p></section>",
