    {
      "name": "Рабочая панель",
      "kind": "card",
      "description": "Белая рабочая поверхность с мягкой смещённой тенью и адаптивным padding.",
      "html": "<section class=\"ds-panel\"><h2>Участники</h2><p>Состав выбранного филиала</p></section>",
      "css": ".ds-panel{font-family:var(--font-sans);min-width:0;background:var(--card);color:var(--foreground);border:0;border-radius:16px;padding:24px;box-shadow:0 4px 18px rgb(32 51 75 / 4%)}.ds-panel h2{margin:0;font-size:17px;line-height:1.4;font-weight:600}.ds-panel p{margin:12px 0 0;color:var(--muted-foreground);font-size:13px;line-height:1.6}@media(max-width:767px){.ds-panel{padding:20px 16px}}",
      "refersTo": "panel"
    },
    {
      "name": "Строка сотрудника",
      "kind": "custom",
      "description": "Несжимающийся fallback-аватар и единые отступы 16 × 12px.",
      "html": "<div class=\"ds-staff\"><span class=\"ds-avatar\"><span aria-hidden=\"true\">ИС</span><span class=\"ds-staff-dot\" role=\"img\" aria-label=\"Действующий аккаунт\" title=\"Действующий аккаунт\"></span></span><div class=\"ds-staff-copy\"><h3>Имя сотрудника</h3><p>Тренер</p><p class=\"ds-assignment\">Назначенный филиал</p></div></div>",
      "css": ".ds-staff{font-family:var(--font-sans);display:flex;align-items:start;gap:16px;padding:16px 12px;color:var(--foreground)}.ds-staff:hover{background:var(--muted)}.ds-avatar{position:relative;display:grid;place-items:center;flex:none;width:44px;height:44px;border:1px solid var(--border);border-radius:50%;background:var(--muted);color:var(--muted-foreground);font-size:14px}.ds-staff-dot{position:absolute;bottom:1px;right:0;width:8px;height:8px;border-radius:50%;background:var(--success);box-shadow:0 0 0 2px var(--card)}.ds-staff-copy{min-width:0;display:flex;flex-direction:column;gap:2px}.ds-staff-copy h3{margin:0;font-size:15px;line-height:22px;font-weight:500;overflow-wrap:anywhere}.ds-staff-copy p{margin:0;color:var(--muted-foreground);font-size:12px;line-height:18px}.ds-staff-copy .ds-assignment{margin-top:4px;font-size:13px;line-height:20px}@media(max-width:767px){.ds-staff{gap:12px}.ds-staff-copy h3{font-size:16px}}@media(prefers-reduced-motion:reduce){.ds-assignment{transition:none;scroll-behavior:auto}.ds-avatar{transition:none;scroll-behavior:auto}.ds-staff{transition:none;scroll-behavior:auto}.ds-staff-copy{transition:none;scroll-behavior:auto}.ds-staff-dot{transition:none;scroll-behavior:auto}}"
