      "html": "<section class=\"ds-sheet\" aria-label=\"Карточка участника\"><header class=\"ds-sheet-header\"><h4>Карточка участника</h4><button type=\"button\" class=\"ds-sheet-close\" aria-label=\"Закрыть панель «Карточка участника»\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 6 6 18M6 6l12 12\"></path></svg></button></header><p>Содержимое рабочей панели</p></section>",
      "css": ".ds-sheet{font-family:var(--font-sans);padding:24px;background:var(--card);color:var(--foreground)}.ds-sheet-header{position:sticky;top:env(safe-area-inset-top);display:flex;align-items:flex-start;gap:12px;padding-block:8px 16px;margin-bottom:20px;background:var(--card)}.ds-sheet-header h4{flex:1;min-width:0;margin:0;font-size:23px;font-weight:600;overflow-wrap:anywhere}.ds-sheet-close{display:grid;place-items:center;flex:none;width:44px;height:44px;min-width:44px;padding:0;margin:0;border:0;background:var(--card);color:var(--foreground);cursor:pointer}.ds-sheet-close:hover:not(:disabled){background:var(--muted)}.ds-sheet-close:focus-visible{outline:2px solid var(--ring);outline-offset:3px;}.ds-sheet-close:disabled{opacity:.6;cursor:default}@media(max-width:767px){.ds-sheet{padding-inline:16px}}@media(prefers-reduced-motion:reduce){.ds-sheet{transition:none;scroll-behavior:auto}.ds-sheet-close{transition:none;scroll-behavior:auto}.ds-sheet-header{transition:none;scroll-behavior:auto}}"
